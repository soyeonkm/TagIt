{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tagit",
  "version": "0.1.0",
  "identifier": "com.soyeo.tagit",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "beforeDevCommand": "cd ../../frontend && npm run dev",
    "beforeBuildCommand": "cd ../../frontend && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tagit",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
